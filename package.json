{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:wink-bridge": "node scripts/verify-wink-bridge.mjs",
    "prebuild": "npm run verify:wink-bridge",
    "sync:wink-bridge": "node scripts/sync-wink-bridge.mjs",
    "verify:wink-config": "sh -c 'set -a; . ./game.config.sh; set +a; node scripts/verify-game-config.mjs'",
    "verify:docker-headers": "sh -c 'set -a; . ./game.config.sh; set +a; node scripts/verify-docker-headers.mjs'",
    "generate:wink-config": "node scripts/generate-wink-runtime-config.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "0.487.0",
    "pixi.js": "^8.19.0",
    "puppeteer": "^25.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.1.12",
    "typescript": "^7.0.2",
    "vite": "6.3.5",
    "vitest": "^4.1.9"
  }
}
